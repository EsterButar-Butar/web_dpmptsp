APP_NAME="Laravel"
APP_ENV=local
APP_KEY="generate_key_kamu_dengan_php_artisan_key:generate"
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST="host_database_kamu"
DB_PORT=5432
DB_DATABASE="nama_database_kamu"
DB_USERNAME="username_database_kamu"
DB_PASSWORD="password_database_kamu"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="email_smtp_kamu@gmail.com"
MAIL_PASSWORD="password_app_email_kamu"
#MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="email_pengirim_kamu@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID="aws_access_key_kamu"
AWS_SECRET_ACCESS_KEY="aws_secret_key_kamu"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET="aws_bucket_kamu"
AWS_USE_PATH_STYLE_ENDPOINT=false

CURRENCYFREAKS_API_KEY="api_key_currency_freaks_kamu"
CURRENCYFREAKS_URL=https://api.currencyfreaks.com/v2.0

VITE_APP_NAME="${APP_NAME}"
